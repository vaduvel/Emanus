

def source_text(source_data: dict[str, Any], lock_id: str, book_id: str, chapter: int, verse: int) -> str:
    refs = validator.source_references_for_target(lock_id, book_id, chapter, verse, source_data["rules"])
    return normalize_space(" ".join(source_data["texts"][lock_id][ref] for ref in refs if ref in source_data["texts"][lock_id]))


def translate_batch(texts: list[str], model_name: str, revision: str, batch_size: int = 24) -> list[str]:
    if not texts:
        return []
    import torch
    from transformers import MarianMTModel, MarianTokenizer

    tokenizer = MarianTokenizer.from_pretrained(model_name, revision=revision)
    model = MarianMTModel.from_pretrained(model_name, revision=revision)
    model.eval()
    results: list[str] = []
    with torch.inference_mode():
        for start in range(0, len(texts), batch_size):
            batch_texts = texts[start:start + batch_size]
            encoded = tokenizer(batch_texts, return_tensors="pt", padding=True, truncation=True, max_length=512)
            generated = model.generate(
                **encoded,
                max_new_tokens=384,
                num_beams=5,
                early_stopping=True,
                renormalize_logits=True,
            )
            results.extend(modernize(text) for text in tokenizer.batch_decode(generated, skip_special_tokens=True))
    del model, tokenizer
    gc.collect()
    return results


def embed(texts: list[str]) -> list[list[float]]:
    from sentence_transformers import SentenceTransformer

    model = SentenceTransformer(EMBEDDING_MODEL)
    vectors = model.encode(texts, batch_size=64, normalize_embeddings=True, show_progress_bar=True)
    result = vectors.tolist()
    del model
    gc.collect()
    return result


def cosine(a: list[float], b: list[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def tokens(value: str) -> set[str]:
    return set(validator.normalize_for_comparison(value).split())


def lexical_overlap(candidate: str, benchmarks: list[str]) -> float:
    cand = tokens(candidate)
    if not cand:
        return 0.0
    scores: list[float] = []
    for benchmark in benchmarks:
        other = tokens(benchmark)
        scores.append(len(cand & other) / max(1, len(cand | other)))
    return max(scores, default=0.0)


def length_score(candidate: str, benchmarks: list[str]) -> float:
    lengths = sorted(max(1, len(validator.normalize_for_comparison(value).split())) for value in benchmarks)
    expected = lengths[len(lengths) // 2]
    actual = max(1, len(validator.normalize_for_comparison(candidate).split()))
    ratio = actual / expected
    return max(0.0, 1.0 - abs(math.log(ratio)))


def penalty(source: str, candidate: str) -> float:
    if not candidate or PLACEHOLDER.search(candidate):
        return 1.0
    score = 0.0
    if re.search(r"(.)\1\1\1", candidate.lower()):
        score += 0.35
    if len(candidate.split()) < 2 and len(source.split()) > 6:
        score += 0.6
    if any(mark in candidate for mark in ("ş", "ţ", "Ş", "Ţ", '"')):
        score += 0.2
    if set(re.findall(r"\d+", source)) != set(re.findall(r"\d+", candidate)):
        score += 0.2
    lower_source = source.lower()
    lower_candidate = candidate.lower()
    for needle, expected in CANONICAL_TERMS.items():
        if needle in lower_source and not any(value.lower() in lower_candidate for value in expected):
            score += 0.055
    return min(1.0, score)


def candidate_score(item: Item, candidate: str, semantic: float, label: str) -> float:
    lexical = lexical_overlap(candidate, item.benchmarks)
    length = length_score(candidate, item.benchmarks)
    preference = 0.08 if label == "existing" else (0.025 if label == "primary" else 0.0)
    return 0.58 * semantic + 0.24 * lexical + 0.18 * length + preference - penalty(item.source, candidate)


