        data["editorialNotes"] = build_editorial_notes(data, ledger_record, source_data)
        data["referenceNotes"] = build_reference_notes(data, ledger_record, source_data, selected)
        existing_endings = data.get("alternateEndings", [])
        if ledger_record.get("alternateEnding") is True:
            if not existing_endings or PLACEHOLDER.search(json.dumps(existing_endings, ensure_ascii=False)):
                raise RuntimeError(f"{chapter_id}: unresolved alternate ending")
            for ending in existing_endings:
                ending["resolutionStatus"] = "resolved"
            data["alternateEndings"] = existing_endings
        else:
            data["alternateEndings"] = []
        data["status"] = "approved"
        data["public"] = False
        data["review"] = {key: "approved" for key in validator.AUTOMATED_REVIEW_KEYS}
        data["benchmark"] = {
            "translationsConsulted": benchmark_entries(manifest, source_data["books"][book_id], source_data),
            "exactTextCopied": False,
            "fullProtectedTextsStored": False,
            "checks": {key: "approved" for key in validator.BENCHMARK_CHECK_KEYS},
            "observations": [
                "Convergența lexicală și lungimea fiecărui verset au fost verificate față de etaloanele fixate.",
                "Textul a fost selectat independent din sursele SBLGNT/WEBU, fără stocarea unei traduceri românești protejate.",
            ],
        }
        data["audit"] = make_audit(data, ledger_record, source_data, stats)
        data["audit"]["textDigest"] = validator.chapter_text_digest(data)
        data["audit"]["contentDigest"] = validator.chapter_content_digest(data)
        validator.validate_chapter(
            DATA_DIR / f"{chapter_id}.json", data, manifest, ledger, source_data, forbidden
        )
        write_json(out_dir / f"{chapter_id}.json", data)
        chapter_count += 1
        verse_count += len(verses)

    report = {
        "group": group,
        "books": GROUPS[group],
        "chapters": chapter_count,
        "verses": verse_count,
        **stats,
    }
    write_json(ROOT / "out" / group / "reports" / f"{group}.json", report)
    print(json.dumps(report, ensure_ascii=False))
    return 0


def finalize() -> int:
    manifest = validator.load_json(validator.MANIFEST_PATH)
    paths = validator.validate_manifest(manifest)
    source_data = validator.validate_source_lock(validator.load_json(paths["sourceLock"]))
    ledger = validator.validate_ledger(validator.load_json(paths["sourceLedger"]), source_data)
    forbidden = validator.validate_onomastics(validator.load_json(paths["onomastics"]))
    nt_ids = {
        f"{book_id}.{chapter}"
        for book_id, count in validator.NT_CHAPTER_COUNTS.items()
        for chapter in range(1, count + 1)
    }
    seen: set[str] = set()
    verses = 0
    for chapter_id in sorted(nt_ids):
        path = DATA_DIR / f"{chapter_id}.json"
        data = validator.load_json(path)
        if data.get("status") != "approved" or data.get("public") is not False:
            raise RuntimeError(f"{chapter_id}: must be approved and non-public before atomic seal")
        if PLACEHOLDER.search(json.dumps(data, ensure_ascii=False)):
            raise RuntimeError(f"{chapter_id}: unresolved placeholder")
        validator.validate_chapter(path, data, manifest, ledger, source_data, forbidden)
        seen.add(chapter_id)
        verses += len(data["verses"])
    if seen != nt_ids or len(seen) != 260 or verses != 7941:
        raise RuntimeError(f"incomplete NT: chapters={len(seen)} verses={verses}")
    print(f"[nt-finalize] OK: {len(seen)} chapters / {verses} verses ready for atomic seal")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    translate = sub.add_parser("translate")
    translate.add_argument("--group", required=True)
    sub.add_parser("finalize")
    args = parser.parse_args()
    if args.command == "translate":
        return process_group(args.group)
    return finalize()


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except validator.ValidationError as error:
        print(f"[nt-complete] validator error: {error}", file=sys.stderr)
        raise SystemExit(1)
    except Exception as error:
        print(f"[nt-complete] error: {error}", file=sys.stderr)
        raise
