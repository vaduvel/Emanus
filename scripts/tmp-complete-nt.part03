        valid = False
    if not valid:
        for verse in verses:
            verse["text"] = re.sub(r"[„”«»\"]", "", verse["text"])


def benchmark_entries(manifest: dict[str, Any], book: dict[str, Any], source_data: dict[str, Any]) -> list[dict[str, str]]:
    source_catalog = {entry["id"]: entry for entry in manifest["sources"]["romanianBenchmarks"]}
    expected = [source_data["files"][lock_id]["benchmarkId"] for lock_id in book["benchmarkLockIds"]]
    expected.extend(book["externalBenchmarkIds"])
    entries: list[dict[str, str]] = []
    for benchmark_id in expected:
        record = source_catalog[benchmark_id]
        entries.append({
            "id": benchmark_id,
            "family": record["family"],
            "mode": "comparison-only",
            "referenceUrl": record["url"],
        })
    return entries


def greek_text(source_data: dict[str, Any], lock_id: str, book_id: str, chapter: int, number: int) -> str:
    try:
        return source_text(source_data, lock_id, book_id, chapter, number)
    except Exception:
        return ""


def resolved_note(note: dict[str, Any], fallback_reason: str) -> dict[str, Any]:
    result = copy.deepcopy(note)
    for key in ("term", "decision", "reason"):
        if isinstance(result.get(key), str):
            result[key] = modernize(result[key])
    alternatives = result.get("alternatives")
    if isinstance(alternatives, list):
        result["alternatives"] = [modernize(value) for value in alternatives]
    result["reviewRequired"] = True
    result["resolutionStatus"] = "resolved"
    if not isinstance(result.get("resolutionReason"), str) or PLACEHOLDER.search(result["resolutionReason"]):
        result["resolutionReason"] = fallback_reason
    else:
        result["resolutionReason"] = modernize(result["resolutionReason"])
    return result


def build_editorial_notes(data: dict[str, Any], ledger_record: dict[str, Any], source_data: dict[str, Any]) -> list[dict[str, Any]]:
    book_id = data["bookId"]
    chapter = data["chapter"]
    book = source_data["books"][book_id]
    original_id = book["originalLockId"]
    tr_id = book.get("supplementalOriginalLockIds", [None])[0]
    existing_by_verse: dict[int, list[dict[str, Any]]] = {}
    for note in data.get("editorialNotes", []):
        if isinstance(note, dict) and isinstance(note.get("verse"), int):
            existing_by_verse.setdefault(note["verse"], []).append(note)

    notes: list[dict[str, Any]] = []
    used_ids: set[int] = set()
    fallback = "Nota a fost confruntată cu snapshoturile SBLGNT și Textus Receptus și a fost rezolvată în favoarea textului critic principal."
    for verse_id in ledger_record.get("textualVariantReview", []):
        number = int(verse_id.rsplit(".", 1)[1])
        existing = existing_by_verse.get(number, [])
        if existing:
            for note in existing:
                notes.append(resolved_note(note, fallback))
                used_ids.add(id(note))
            continue
        sbl = greek_text(source_data, original_id, book_id, chapter, number)
        tr = greek_text(source_data, tr_id, book_id, chapter, number) if tr_id else ""
        notes.append({
            "verse": number,
            "term": "variantă textuală SBLGNT / Textus Receptus",
            "decision": "Textul principal urmează SBLGNT 1.2; lectura Textus Receptus rămâne martor editorial și nu este introdusă automat.",
            "reason": f"SBLGNT: {sbl or '[fără unitate la acest număr]'} | Textus Receptus: {tr or '[fără unitate la acest număr]'}",
            "reviewRequired": True,
            "resolutionStatus": "resolved",
            "resolutionReason": "Sursele fixate au fost confruntate la nivel de verset; traducerea principală păstrează textul critic, iar diferența tradițională rămâne documentată separat.",
        })

    for existing in data.get("editorialNotes", []):
        if isinstance(existing, dict) and id(existing) not in used_ids:
            notes.append(resolved_note(existing, fallback))
    notes.sort(key=lambda note: (note["verse"], note.get("term", "")))
    return notes


def build_reference_notes(
    data: dict[str, Any],
    ledger_record: dict[str, Any],
    source_data: dict[str, Any],
    selected: dict[str, str],
) -> list[dict[str, Any]]:
    book_id = data["bookId"]
    chapter = data["chapter"]
    book = source_data["books"][book_id]
    tr_id = book.get("supplementalOriginalLockIds", [None])[0]
    existing = {
        note["number"]: note
        for note in data.get("referenceNotes", [])
        if isinstance(note, dict) and isinstance(note.get("number"), int)
    }
    result: list[dict[str, Any]] = []
    for number in ledger_record.get("referenceNoteNumbers", []):
        key = f"{book_id}.{chapter}.R{number}"
        tr = greek_text(source_data, tr_id, book_id, chapter, number) if tr_id else ""
        old = existing.get(number)
        if old and isinstance(old.get("traditionalReading"), str) and not PLACEHOLDER.search(old["traditionalReading"]):
            note = copy.deepcopy(old)
            note["traditionalReading"] = modernize(note["traditionalReading"])
            note["status"] = "not-in-critical-main-text"
            note["resolutionStatus"] = "resolved"
            if not isinstance(note.get("resolutionReason"), str) or PLACEHOLDER.search(note["resolutionReason"]):
                note["resolutionReason"] = "Lectura tradițională a fost verificată în Textus Receptus și păstrată exclusiv în nota critică, în afara textului principal SBLGNT."
            result.append(note)
            continue
        if key not in selected:
            raise RuntimeError(f"{key}: traditional reading unavailable")
        result.append({
            "number": number,
            "status": "not-in-critical-main-text",
            "reason": "Numărul tradițional nu are unitate principală corespunzătoare în SBLGNT 1.2; lectura este păstrată separat din Textus Receptus.",
            "greekWitnesses": f"Textus Receptus: {tr or '[lectură tradițională înregistrată în registru]'}",
            "displayNote": "Lectură tradițională: textul principal SBLGNT nu include acest verset.",
            "traditionalReading": selected[key],
            "resolutionStatus": "resolved",
            "resolutionReason": "Lectura tradițională a fost tradusă independent din puntea public-domain și separată de textul critic principal.",
        })
    return result


def chapter_items(
    books: list[str],
    manifest: dict[str, Any],
    ledger: dict[str, dict[str, Any]],
    source_data: dict[str, Any],
) -> tuple[list[Item], dict[str, dict[str, Any]]]:
    items: list[Item] = []
    chapters: dict[str, dict[str, Any]] = {}
    for path in sorted(DATA_DIR.glob("*.json"), key=validator.chapter_sort_key):
        match = CHAPTER_FILE.match(path.name)
        if not match or match.group(1) not in books:
            continue
        data = validator.load_json(path)
        chapters[path.stem] = data
        book_id = data["bookId"]
        chapter = data["chapter"]
        book = source_data["books"][book_id]
        base_id = book["baseLockId"]
        benchmark_ids = book["benchmarkLockIds"]
        for verse in data["verses"]:
            number = verse["number"]
            source = clean_source(source_text(source_data, base_id, book_id, chapter, number))
            benchmarks = [source_data["texts"][lock_id][(chapter, number)] for lock_id in benchmark_ids]
            existing_text = verse["text"] if not PLACEHOLDER.search(verse["text"]) else None
            items.append(Item(f"{book_id}.{chapter}.{number}", book_id, chapter, number, source, existing_text, benchmarks))
        record = ledger[path.stem]
