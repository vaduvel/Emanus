            labels.append(("existing", modernize(item.existing)))
        if item.key in primary:
            labels.append(("primary", primary[item.key]))
        if item.key in secondary:
            labels.append(("secondary", secondary[item.key]))
        if not labels:
            raise RuntimeError(f"{item.key}: no translation candidate")
        all_texts.append(item.source)
        for label, text in labels:
            candidate_records.append((item, label, text))
            all_texts.append(text)

    vectors = embed(all_texts)
    index = 0
    source_vectors: dict[str, list[float]] = {}
    candidate_vectors: dict[tuple[str, str], list[float]] = {}
    for item in items:
        source_vectors[item.key] = vectors[index]
        index += 1
        labels = []
        if item.existing and not PLACEHOLDER.search(item.existing):
            labels.append(("existing", modernize(item.existing)))
        if item.key in primary:
            labels.append(("primary", primary[item.key]))
        if item.key in secondary:
            labels.append(("secondary", secondary[item.key]))
        for label, _ in labels:
            candidate_vectors[(item.key, label)] = vectors[index]
            index += 1

    selected: dict[str, str] = {}
    selections = {"existing": 0, "primary": 0, "secondary": 0}
    minimum_semantic = 1.0
    minimum_score = 1.0
    weak: list[dict[str, Any]] = []
    for item in items:
        options: list[tuple[float, float, str, str]] = []
        if item.existing and not PLACEHOLDER.search(item.existing):
            text = modernize(item.existing)
            semantic = cosine(source_vectors[item.key], candidate_vectors[(item.key, "existing")])
            options.append((candidate_score(item, text, semantic, "existing"), semantic, "existing", text))
        for label, mapping in (("primary", primary), ("secondary", secondary)):
            if item.key in mapping:
                text = mapping[item.key]
                semantic = cosine(source_vectors[item.key], candidate_vectors[(item.key, label)])
                options.append((candidate_score(item, text, semantic, label), semantic, label, text))
        options.sort(reverse=True, key=lambda value: value[0])
        aggregate, semantic, label, text = options[0]
        if semantic < 0.25 or aggregate < 0.20:
            weak.append({"key": item.key, "semantic": semantic, "score": aggregate, "label": label, "text": text})
        selected[item.key] = text
        selections[label] += 1
        minimum_semantic = min(minimum_semantic, semantic)
        minimum_score = min(minimum_score, aggregate)
    if weak:
        raise RuntimeError("weak translations: " + json.dumps(weak[:12], ensure_ascii=False))
    return selected, {
        "selected": selections,
        "minimumSemantic": minimum_semantic,
        "minimumScore": minimum_score,
    }


def normalize_chapter_quotes(verses: list[dict[str, Any]]) -> None:
    outer_open = False
    inner_open = False
    for verse in verses:
        text = verse["text"].replace("“", '"').replace("”", '"')
        rendered: list[str] = []
        for char in text:
            if char == '"':
                rendered.append("„" if not outer_open else "”")
                outer_open = not outer_open
            elif char == "„":
                outer_open = True
                rendered.append(char)
            elif char == "”":
                outer_open = False
                rendered.append(char)
            elif char == "«":
                inner_open = True
                rendered.append(char)
            elif char == "»":
                inner_open = False
                rendered.append(char)
            else:
                rendered.append(char)
        verse["text"] = modernize("".join(rendered))
    if outer_open:
        verses[-1]["text"] += "”"
    if inner_open:
        verses[-1]["text"] += "»"

    full = " ".join(verse["text"] for verse in verses)
    stack: list[str] = []
    pairs = {"„": "”", "«": "»"}
    valid = True
    for char in full:
        if char in pairs:
            stack.append(pairs[char])
        elif char in {"”", "»"}:
            if not stack or stack.pop() != char:
                valid = False
                break
    if stack:
