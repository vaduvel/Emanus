    "g09-pastoral": ["1TI", "2TI", "TIT", "PHM"],
    "g10-heb-jas": ["HEB", "JAS"],
    "g11-catholic": ["1PE", "2PE", "1JN", "2JN", "3JN", "JUD"],
    "g12-rev": ["REV"],
}

PRIMARY_MODEL = "Helsinki-NLP/opus-mt-en-ro"
PRIMARY_REVISION = "96e8fea9e44dae942c2e8a9078dc1615dd871ed9"
SECONDARY_MODEL = "Helsinki-NLP/opus-mt-tc-big-en-ro"
SECONDARY_REVISION = "659fa2f20c185abeaf92382d3bf7578bf4e462dd"
EMBEDDING_MODEL = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
AUDIT_ENGINE = "biblia-emanus-nt-ensemble-3.0/opus-en-ro+opus-tc-big+multilingual-minilm"
PLACEHOLDER = re.compile(r"(?:\bDE (?:TRADUS|DOCUMENTAT|VERIFICAT)\b|\b(?:TODO|TBD|FIXME)\b|<placeholder>)")
CHAPTER_FILE = re.compile(r"^([A-Z0-9]{3})\.([1-9][0-9]*)\.json$")
SEDILLA = str.maketrans({"ş": "ș", "ţ": "ț", "Ş": "Ș", "Ţ": "Ț"})

MODERN_WORDS = {
    "atît": "atât", "Atît": "Atât", "încît": "încât", "Încît": "Încât",
    "sînt": "sunt", "Sînt": "Sunt", "sîntem": "suntem", "Sîntem": "Suntem",
    "sînteți": "sunteți", "Sînteți": "Sunteți", "vecinic": "veșnic",
    "Vecinic": "Veșnic", "vecinică": "veșnică", "Vecinică": "Veșnică",
    "vecinici": "veșnici", "Vecinici": "Veșnici", "vecinice": "veșnice",
    "Vecinice": "Veșnice", "Cristos": "Hristos", "Iisus": "Isus",
    "Iacob": "Iacov", "Rahab": "Rahav", "Ghilad": "Galaad",
}

CANONICAL_TERMS: dict[str, tuple[str, ...]] = {
    "jesus": ("Isus",), "christ": ("Hristos",), "god": ("Dumneze",),
    "holy spirit": ("Duhul Sfânt", "Duh Sfânt"), "gospel": ("Evanghel",),
    "resurrection": ("învier",), "eternal": ("veșnic",), "baptiz": ("botez",),
}

@dataclass
class Item:
    key: str
    book_id: str
    chapter: int
    number: int
    source: str
    existing: str | None
    benchmarks: list[str]
    kind: str = "verse"


def write_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def normalize_space(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip()


def modernize(value: str) -> str:
    value = unicodedata.normalize("NFC", value.translate(SEDILLA))
    value = value.replace("–", "—")
    for old, new in MODERN_WORDS.items():
        value = re.sub(rf"\b{re.escape(old)}\b", new, value)
    value = re.sub(r"\bIsus\s+Cristos\b", "Isus Hristos", value)
    value = re.sub(r"\bCristos\s+Isus\b", "Hristos Isus", value)
    value = value.replace("singurul și unicul Său Fiu", "singurul Său Fiu")
    value = value.replace("singurul şi unicul Său Fiu", "singurul Său Fiu")
    value = normalize_space(value)
    value = re.sub(r"\s+([,.;:!?])", r"\1", value)
    return unicodedata.normalize("NFC", value)


def clean_source(value: str) -> str:
    return normalize_space(value.replace("Yahweh", "the LORD"))
