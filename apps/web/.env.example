# In dev, gol/"/api" => foloseste proxy-ul Vite catre API-ul local (:3000).
# In build-ul de mobil (Capacitor) pune URL-ul complet al API-ului, ex:
# VITE_API_URL=https://api.emanus.app
VITE_API_URL=/api

# --- Supabase (copie de siguranta a drumului, jurnalului si rugaciunilor) ---
# Copiaza fisierul asta in apps/web/.env.local si pune valorile reale acolo.
# .env.local NU se urca in git. Repo-ul e public.
#
# Se pune DOAR cheia publishable (publica prin definitie, ajunge oricum in browser).
# Cheia secreta (sb_secret_... / service_role) NU are voie sa apara niciodata in
# apps/web: ocoleste politicile RLS si ar da oricui jurnalele si rugaciunile tuturor.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
