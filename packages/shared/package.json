{
  "name": "@emanus/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./paths": {
      "types": "./dist/paths/index.d.ts",
      "default": "./dist/paths/index.js"
    },
    "./library": {
      "types": "./dist/library/current.d.ts",
      "default": "./dist/library/current.js"
    },
    "./bible": {
      "types": "./dist/bible/index.d.ts",
      "default": "./dist/bible/index.js"
    },
    "./bible-types": {
      "types": "./dist/bible/types.d.ts",
      "default": "./dist/bible/types.js"
    },
    "./lesson-mohler": {
      "types": "./dist/lessonMohler.d.ts",
      "default": "./dist/lessonMohler.js"
    },
    "./lesson-safety": {
      "types": "./dist/lessonSafety.d.ts",
      "default": "./dist/lessonSafety.js"
    },
    "./safety-resources": {
      "types": "./dist/safetyResources.d.ts",
      "default": "./dist/safetyResources.js"
    },
    "./bible-explained": {
      "types": "./dist/bible/overlays/index.d.ts",
      "default": "./dist/bible/overlays/index.js"
    },
    "./bible-publication": {
      "types": "./dist/bible/publicationBibleFinal.d.ts",
      "default": "./dist/bible/publicationBibleFinal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
