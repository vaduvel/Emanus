{
  "name": "emanus",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @emanus/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @emanus/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @emanus/web dev",
    "typecheck": "pnpm build:shared && pnpm --filter @emanus/db build && pnpm -r typecheck",
    "generate:content-manifest": "pnpm build:shared && node scripts/generate-content-manifest.mjs",
    "check:content-manifest": "pnpm build:shared && node scripts/generate-content-manifest.mjs --check",
    "check:content": "pnpm check:content-manifest && pnpm --filter @emanus/db validate-content",
    "content:publish": "pnpm generate:content-manifest && pnpm --filter @emanus/db publish-content",
    "fix:quotes": "python3 scripts/fix-quotes.py",
    "check:quotes": "python3 scripts/fix-quotes.py --check"
  }
}
