{
  "name": "emanus",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @emanus/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @emanus/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @emanus/web dev",
    "typecheck": "pnpm build:shared && pnpm --filter @emanus/db build && pnpm -r typecheck",
    "fix:quotes": "python3 scripts/fix-quotes.py",
    "check:quotes": "python3 scripts/fix-quotes.py --check",
    "check:typos": "python3 scripts/fix-known-typos.py --check",
    "check:content": "python3 scripts/audit-content.py",
    "check:active-content": "python3 scripts/check-active-content.py",
    "check:bible-publication": "python3 scripts/publica-geneza.py --check && python3 scripts/publica-matei.py --check",
    "check:matei": "python3 scripts/check-matei.py",
    "check:marcu": "python3 scripts/check-marcu.py",
    "check:luca": "python3 scripts/check-luca.py",
    "check:fapte": "python3 scripts/check-fapte.py",
    "check:romani": "python3 scripts/check-romani.py",
    "check:tit": "python3 scripts/check-tit.py",
    "check:filimon": "python3 scripts/check-filimon.py",
    "check:bible-source": "pnpm build:shared && pnpm --filter @emanus/web check:bible-source",
    "check:bible-cloud": "python3 scripts/check-bible-cloud.py",
    "check:bible-bundle": "python3 scripts/check-bible-cloud.py --bundle",
    "sync:bible-content": "pnpm build:shared && pnpm --filter @emanus/web sync:bible-content",
    "check:1-corinteni": "python3 scripts/check-1-corinteni.py",
    "check:2-corinteni": "python3 scripts/check-2-corinteni.py",
    "check:galateni": "python3 scripts/check-galateni.py",
    "check:efeseni": "python3 scripts/check-efeseni.py",
    "check:filipeni": "python3 scripts/check-filipeni.py",
    "check:coloseni": "python3 scripts/check-coloseni.py"
  }
}
