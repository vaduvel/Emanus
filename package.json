{
  "name": "emanus",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @emanus/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @emanus/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @emanus/web dev",
    "typecheck": "pnpm build:shared && pnpm --filter @emanus/db build && pnpm -r typecheck",
    "fix:quotes": "python3 scripts/fix-quotes.py",
    "check:quotes": "python3 scripts/fix-quotes.py --check",
    "check:typos": "python3 scripts/fix-known-typos.py --check",
    "check:content": "python3 scripts/audit-content.py",
    "check:bible-publication": "python3 scripts/publica-geneza.py --check",
    "check:biblia-emanus": "python3 scripts/check-biblia-emanus.py",
    "check:biblia-emanus-ot-quality": "python3 scripts/check-biblia-emanus-romanian-quality.py --testament OT",
    "check:biblia-emanus-ot-source-evidence": "python3 scripts/check-biblia-emanus-ot-source-evidence.py",
    "pack:biblia-emanus-ot-source-evidence": "python3 scripts/pack-biblia-emanus-ot-source-evidence.py",
    "review:biblia-emanus-ot": "python3 scripts/review-biblia-emanus-ot-with-openai-compatible.py",
    "test:biblia-emanus": "python3 -m unittest scripts/test_biblia_emanus.py scripts/test_biblia_emanus_nt.py scripts/test_materialize_biblia_emanus_nt.py scripts/test_biblia_emanus_ot_source_evidence.py",
    "seal:biblia-emanus": "python3 scripts/seal-biblia-emanus.py",
    "check:biblia-emanus-versification": "python3 scripts/check-biblia-emanus-versification.py",
    "check:biblia-emanus-book": "python3 scripts/check-biblia-emanus-book.py",
    "materialize:biblia-emanus-nt": "python3 scripts/materialize-biblia-emanus-nt.py",
    "check:biblia-emanus-nt-materialized": "python3 scripts/materialize-biblia-emanus-nt.py --check",
    "materialize:nt-explained-runtime": "node scripts/materialize-nt-publication-runtime.mjs",
    "check:nt-explained-recovery": "node scripts/check-nt-explanation-recovery.mjs",
    "check:nt-source-first": "node scripts/check-nt-source-first.mjs",
    "check:nt-audited-recovered": "node scripts/check-nt-audited-recovered.mjs",
    "check:nt-final-source-first": "node scripts/check-nt-final-source-first.mjs"
  }
}
