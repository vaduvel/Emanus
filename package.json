{
  "name": "emanus",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @emanus/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @emanus/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @emanus/web dev",
    "typecheck": "pnpm build:shared && pnpm --filter @emanus/db build && pnpm -r typecheck",
    "fix:quotes": "python3 scripts/fix-quotes.py",
    "check:quotes": "python3 scripts/fix-quotes.py --check",
    "check:typos": "python3 scripts/fix-known-typos.py --check",
    "check:content": "python3 scripts/audit-content.py",
    "check:active-content": "python3 scripts/check-active-content.py",
    "check:bible-publication": "python3 scripts/publica-geneza.py --check && python3 scripts/publica-matei.py --check",
    "check:biblia-emanus": "python3 scripts/check-biblia-emanus.py",
    "test:biblia-emanus": "python3 -m unittest scripts/test_biblia_emanus.py scripts/test_biblia_emanus_nt.py scripts/test_materialize_biblia_emanus_nt.py",
    "seal:biblia-emanus": "python3 scripts/seal-biblia-emanus.py",
    "check:biblia-emanus-versification": "python3 scripts/check-biblia-emanus-versification.py",
    "check:biblia-emanus-book": "python3 scripts/check-biblia-emanus-book.py",
    "materialize:biblia-emanus-nt": "python3 scripts/materialize-biblia-emanus-nt.py",
    "check:biblia-emanus-nt-materialized": "python3 scripts/materialize-biblia-emanus-nt.py --check",
    "check:matei": "python3 scripts/check-matei.py",
    "check:marcu": "python3 scripts/check-marcu.py",
    "check:luca": "python3 scripts/check-luca.py",
    "check:fapte": "python3 scripts/check-fapte.py",
    "check:romani": "python3 scripts/check-romani.py",
    "check:tit": "python3 scripts/check-tit.py",
    "check:filimon": "python3 scripts/check-filimon.py",
    "check:bible-source": "pnpm build:shared && pnpm --filter @emanus/web check:bible-source",
    "check:bible-cloud": "python3 scripts/check-bible-cloud.py",
    "check:bible-bundle": "python3 scripts/check-bible-cloud.py --bundle",
    "sync:bible-content": "pnpm build:shared && pnpm --filter @emanus/web sync:bible-content",
    "check:1-corinteni": "python3 scripts/check-1-corinteni.py",
    "check:2-corinteni": "python3 scripts/check-2-corinteni.py",
    "check:galateni": "python3 scripts/check-galateni.py",
    "check:efeseni": "python3 scripts/check-efeseni.py",
    "check:filipeni": "python3 scripts/check-filipeni.py",
    "check:coloseni": "python3 scripts/check-coloseni.py",
    "check:1-tesaloniceni": "python3 scripts/check-1-tesaloniceni.py",
    "check:2-tesaloniceni": "python3 scripts/check-nt-completion.py --book 2-tesaloniceni",
    "check:1-timotei": "python3 scripts/check-nt-completion.py --book 1-timotei",
    "check:2-timotei": "python3 scripts/check-nt-completion.py --book 2-timotei",
    "check:evrei": "python3 scripts/check-nt-completion.py --book evrei",
    "check:iacov": "python3 scripts/check-nt-completion.py --book iacov",
    "check:1-petru": "python3 scripts/check-nt-completion.py --book 1-petru",
    "check:2-petru": "python3 scripts/check-nt-completion.py --book 2-petru",
    "check:1-ioan": "python3 scripts/check-nt-completion.py --book 1-ioan",
    "check:2-ioan": "python3 scripts/check-nt-completion.py --book 2-ioan",
    "check:3-ioan": "python3 scripts/check-nt-completion.py --book 3-ioan",
    "check:iuda": "python3 scripts/check-nt-completion.py --book iuda",
    "check:apocalipsa": "python3 scripts/check-nt-completion.py --book apocalipsa",
    "check:nt-completion": "python3 scripts/check-nt-completion.py",
    "check:rut": "python3 scripts/check-rut.py",
    "check:1-samuel": "python3 scripts/check-1-samuel.py"
  }
}
