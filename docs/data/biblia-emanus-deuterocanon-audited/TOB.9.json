  "verses": [
    {
      "number": 1,
      "text": "Tobias a chemat pe Rafael, și i -a zis:"
    },
    {
      "number": 2,
      "text": "Frate Azarias, ia cu tine un servitor și două cămile, și du-te la Rage of Media la Gabael, și ia banii pentru mine, și adu-l la sărbătoarea de nuntă,"
    },
    {
      "number": 3,
      "text": "Pentru că Raguel a jurat că nu trebuie să plec."
    },
    {
      "number": 4,
      "text": "Tatăl meu contează zilele; și dacă aștept mult timp, el va fi foarte îndurerat."
    },
    {
      "number": 5,
      "text": "Rafael s'a dus, s'a culcat cu Gabael, și i -a dat scrisul. A adus sacii cu pecețile lor, și i -a dat."
    },
    {
      "number": 6,
      "text": "Apoi s'au sculat dis -de -dimineață împreună, și au venit la ospățul de nuntă. Tobias a binecuvîntat pe nevasta lui."
    }
  ],
