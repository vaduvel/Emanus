  "verses": [
    {
      "number": 1,
      "text": "Am fost mic printre frații mei, și mai tânăr în casa tatălui meu. Am avut grijă de oile tatălui meu."
    },
    {
      "number": 2,
      "text": "Mâinile mele formau un instrument muzical, iar degetele mele acordau o liră."
    },
    {
      "number": 3,
      "text": "Cine-i va spune Domnului meu? Domnul însuși aude."
    },
    {
      "number": 4,
      "text": "El și - a trimis îngerul și m - a luat de la oile tatălui meu și m - a uns cu untdelemnul lui de ungere."
    },
    {
      "number": 5,
      "text": "Frații mei erau frumoși și înalți, dar Domnul n-a găsit plăcere în ei."
    },
    {
      "number": 6,
      "text": "M-am dus să-l întâlnesc pe Filistean, iar el m-a blestemat de idolii lui."
    },
    {
      "number": 7,
      "text": "Dar eu i-am scos sabia, l-am decapitat am îndepărtat ocara de la copiii lui Israel."
    }
  ],
