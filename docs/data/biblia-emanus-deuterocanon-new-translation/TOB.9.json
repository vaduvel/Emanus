  "verses": [
    {
      "number": 1,
      "text": "Tobias a chemat pe Rafael, şi i -a zis:"
    },
    {
      "number": 2,
      "text": "Frate Azarias, ia cu tine un servitor şi două cămile, şi du-te la Rage of Media la Gabael, şi ia banii pentru mine, şi adu-l la sărbătoarea de nuntă,"
    },
    {
      "number": 3,
      "text": "Pentru că Raguel a jurat că nu trebuie să plec."
    },
    {
      "number": 4,
      "text": "Tatăl meu contează zilele; și dacă aștept mult timp, el va fi foarte îndurerat."
    },
    {
      "number": 5,
      "text": "Rafael s'a dus, s'a culcat cu Gabael, şi i -a dat scrisul. A adus sacii cu peceţile lor, şi i -a dat."
    },
    {
      "number": 6,
      "text": "Apoi s'au sculat dis -de -dimineaţă împreună, şi au venit la ospăţul de nuntă. Tobias a binecuvîntat pe nevasta lui."
    }
  ],
