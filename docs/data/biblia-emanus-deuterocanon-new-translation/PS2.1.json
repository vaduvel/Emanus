  "verses": [
    {
      "number": 1,
      "text": "Am fost mic printre fraţii mei, şi mai tânăr în casa tatălui meu. Am avut grijă de oile tatălui meu."
    },
    {
      "number": 2,
      "text": "Mâinile mele au format un instrument muzical, iar degetele mi-au acordat o liră."
    },
    {
      "number": 3,
      "text": "Cine-i va spune Domnului meu? Domnul însuşi aude."
    },
    {
      "number": 4,
      "text": "El şi - a trimis îngerul şi m - a luat de la oile tatălui meu şi m - a uns cu untdelemnul lui de ungere."
    },
    {
      "number": 5,
      "text": "Fraţii mei erau frumoşi şi înalţi, dar Domnul n-a găsit plăcere în ei."
    },
    {
      "number": 6,
      "text": "M-am dus să-l întâlnesc pe Filistean, iar el m-a blestemat de idolii lui."
    },
    {
      "number": 7,
      "text": "Dar am scos sabia lui şi l-am decapitat, şi am îndepărtat ocara de la copiii lui Israel."
    }
  ],
