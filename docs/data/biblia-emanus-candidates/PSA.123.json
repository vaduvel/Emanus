  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor.) La Tine îmi ridic ochii, la Tine care locuiești în ceruri."
    },
    {
      "number": 2,
      "text": "Cum se uită ochii robilor la mâna stăpânilor lor, și ochii roabei, la mâna stăpânei ei, așa se uită ochii noștri la DOMNUL Dumnezeul nostru până va avea milă de noi."
    },
    {
      "number": 3,
      "text": "Ai milă de noi, DOAMNE, ai milă de noi, căci suntem sătui de dispreț;"
    },
    {
      "number": 4,
      "text": "ne este sătul sufletul de batjocurile celor îngâmfați, de disprețul celor trufași."
    }
  ],
