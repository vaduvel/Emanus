  "verses": [
    {
      "number": 1,
      "text": "Pe malurile râurilor Babilonului ședeam jos și plângeam, când ne aduceam aminte de Sion."
    },
    {
      "number": 2,
      "text": "În sălciile din ținutul acela ne atârnaserăm harpele."
    },
    {
      "number": 3,
      "text": "Căci acolo, biruitorii noștri ne cereau cântări, și asupritorii noștri ne cereau bucurie, zicând: „Cântați-ne câteva din cântările Sionului!”"
    },
    {
      "number": 4,
      "text": "Cum să cântăm noi cântările DOMNULUI pe un pământ străin?"
    },
    {
      "number": 5,
      "text": "Dacă te voi uita, Ierusalime, să-și uite dreapta mea destoinicia ei!"
    },
    {
      "number": 6,
      "text": "Să mi se lipească limba de cerul gurii, dacă nu-mi voi aduce aminte de tine, dacă nu voi face din Ierusalim culmea bucuriei mele!"
    },
    {
      "number": 7,
      "text": "Adu-Ți aminte, DOAMNE, de copiii Edomului, care, în ziua nenorocirii Ierusalimului, ziceau: „Radeți-l, radeți-l din temelii!”"
    },
    {
      "number": 8,
      "text": "Ah! fiica Babilonului, sortită pustiirii, ferice de cine-ți va întoarce la fel răul pe care ni l-ai făcut!"
    },
    {
      "number": 9,
      "text": "Ferice de cine va apuca pe pruncii tăi și-i va zdrobi de stâncă!"
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic"
}
