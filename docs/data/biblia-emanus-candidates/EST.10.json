  "verses": [
    {
      "number": 1,
      "text": "Regele Ahașveroș a impus tribut ținuturilor sale, până și insulelor mării."
    },
    {
      "number": 2,
      "text": "Faptele prin care și-a arătat tăria, precum și relatarea deplină despre rangul înalt la care regele l-a ridicat pe Mardoheu, sunt consemnate în Cartea Cronicilor regilor Mediei și Persiei."
    },
    {
      "number": 3,
      "text": "Mardoheu, iudeul, era al doilea după regele Ahașveroș. Se bucura de mare cinste între iudei și de prețuirea numeroșilor săi frați, fiindcă urmărea binele poporului său și pleda pentru pacea tuturor urmașilor lui."
    }
  ],
