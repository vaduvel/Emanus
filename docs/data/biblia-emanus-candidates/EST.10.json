  "verses": [
    {
      "number": 1,
      "text": "Împăratul Ahașveroș a pus un bir asupra țării și asupra ostroavelor mării."
    },
    {
      "number": 2,
      "text": "Toate faptele privitoare la puterea lui și isprăvile lui și amănuntele despre mărimea la care a ridicat împăratul pe Mardoheu, nu sunt scrise în cartea Cronicilor împăraților Mezilor și Perșilor?"
    },
    {
      "number": 3,
      "text": "Căci Iudeul Mardoheu era cel dintâi după împăratul Ahașveroș. El era cu vază între Iudei și iubit de mulțimea fraților săi, căci a căutat binele poporului său și a vorbit pentru fericirea întregului său neam."
    }
  ],
