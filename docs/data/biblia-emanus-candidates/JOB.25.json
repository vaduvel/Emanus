  "verses": [
    {
      "number": 1,
      "text": "Bildad din Șuah a luat cuvântul și a zis:"
    },
    {
      "number": 2,
      "text": "„Puterea și groaza sunt ale lui Dumnezeu; El face să împărățească pacea în ținuturile Lui înalte.”"
    },
    {
      "number": 3,
      "text": "Cine ar putea să-I numere oștile? Și peste cine nu răsare lumina Lui?"
    },
    {
      "number": 4,
      "text": "Cum ar putea omul să fie fără vină înaintea lui Dumnezeu? Cum ar putea cel născut din femeie să fie curat?"
    },
    {
      "number": 5,
      "text": "Iată, în ochii Lui nici luna nu este strălucitoare, și stelele nu sunt curate înaintea Lui;"
    },
    {
      "number": 6,
      "text": "„cu cât mai puțin omul, care nu este decât un vierme, fiul omului, care nu este decât un viermișor!”"
    }
  ],
