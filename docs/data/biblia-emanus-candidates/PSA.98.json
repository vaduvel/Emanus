  "verses": [
    {
      "number": 1,
      "text": "Cântați DOMNULUI o cântare nouă, căci El a făcut minuni. Dreapta și brațul Lui cel sfânt I-au venit în ajutor."
    },
    {
      "number": 2,
      "text": "DOMNUL Și-a arătat mântuirea, Și-a descoperit dreptatea înaintea neamurilor."
    },
    {
      "number": 3,
      "text": "Și-a adus aminte de bunătatea și credincioșia Lui față de casa lui Israel: toate marginile pământului au văzut mântuirea Dumnezeului nostru."
    },
    {
      "number": 4,
      "text": "Strigați către DOMNUL cu strigăte de bucurie, toți locuitorii pământului! Chiuiți, strigați și cântați laude!"
    },
    {
      "number": 5,
      "text": "Cântați DOMNULUI cu harpa, cu harpa și cu cântece din gură!"
    },
    {
      "number": 6,
      "text": "Cu trâmbițe și sunete din corn, strigați de bucurie înaintea împăratului, DOMNULUI!"
    },
    {
      "number": 7,
      "text": "Să urle marea cu tot ce cuprinde ea, să chiuie lumea și cei ce locuiesc pe ea,"
    },
    {
      "number": 8,
      "text": "să bată din palme râurile, să strige de bucurie toți munții"
    },
    {
      "number": 9,
      "text": "înaintea DOMNULUI! Căci El vine să judece pământul! El va judeca lumea cu dreptate, și popoarele, cu nepărtinire."
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic",
  "superscription": "(Un psalm.)"
