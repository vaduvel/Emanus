  "verses": [
    {
      "number": 1,
      "text": "În ziua aceea vei zice: „Te laud, DOAMNE, căci ai fost supărat pe mine, dar mânia Ta s-a potolit, și m-ai mângâiat!”"
    },
    {
      "number": 2,
      "text": "„Iată, Dumnezeu este izbăvirea mea, voi fi plin de încredere și nu mă voi teme de nimic; căci DOMNUL Dumnezeu este tăria mea și pricina laudelor mele, și El m-a mântuit.”"
    },
    {
      "number": 3,
      "text": "Veți scoate apă cu bucurie din izvoarele mântuirii"
    },
    {
      "number": 4,
      "text": "și veți zice în ziua aceea: „Lăudați pe DOMNUL, chemați Numele Lui, vestiți lucrările Lui printre popoare, pomeniți mărimea Numelui Lui!”"
    },
    {
      "number": 5,
      "text": "Cântați DOMNULUI, căci a făcut lucruri strălucite: să fie cunoscute în tot pământul!"
    },
    {
      "number": 6,
      "text": "„Strigă de bucurie și veselie, locuitoare a Sionului, căci mare este în mijlocul tău Sfântul lui Israel.”"
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic"
