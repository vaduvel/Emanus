  "verses": [
    {
      "number": 1,
      "text": "DOMNUL împărățește îmbrăcat cu măreție; DOMNUL este îmbrăcat și încins cu putere: de aceea lumea este tare și nu se clatină."
    },
    {
      "number": 2,
      "text": "Scaunul Tău de domnie este așezat din vremuri străvechi; Tu ești din veșnicie!"
    },
    {
      "number": 3,
      "text": "Râurile vuiesc, DOAMNE, râurile vuiesc tare, râurile se umflă cu putere."
    },
    {
      "number": 4,
      "text": "Dar mai puternic decât vuietul apelor mari și mai puternic decât vuietul valurilor năprasnice ale mării este DOMNUL în locurile cerești."
    },
    {
      "number": 5,
      "text": "Mărturiile Tale sunt cu totul adevărate; sfințenia este podoaba Casei Tale, DOAMNE, pentru tot timpul cât vor ține vremurile."
    }
  ],
