  "verses": [
    {
      "number": 1,
      "text": "(Un psalm al lui David.) Fă-mi dreptate, DOAMNE, căci umblu în nevinovăție și mă încred în DOMNUL fără șovăire."
    },
    {
      "number": 2,
      "text": "Cercetează-mă, DOAMNE, încearcă-mă, trece-mi prin cuptorul de foc rărunchii și inima!"
    },
    {
      "number": 3,
      "text": "Căci bunătatea Ta este înaintea ochilor mei, și umblu în adevărul Tău."
    },
    {
      "number": 4,
      "text": "Nu șed împreună cu oamenii mincinoși și nu merg împreună cu oamenii vicleni."
    },
    {
      "number": 5,
      "text": "Urăsc adunarea celor ce fac răul și nu stau împreună cu cei răi."
    },
    {
      "number": 6,
      "text": "Îmi spăl mâinile în nevinovăție și așa înconjor altarul Tău, DOAMNE,"
    },
    {
      "number": 7,
      "text": "ca să izbucnesc în mulțumiri și să istorisesc toate minunile Tale."
    },
    {
      "number": 8,
      "text": "DOAMNE, eu iubesc locașul Casei Tale și locul în care locuiește slava Ta."
    },
    {
      "number": 9,
      "text": "Nu-mi lua sufletul împreună cu păcătoșii, nici viața cu oamenii care varsă sânge,"
    },
    {
      "number": 10,
      "text": "ale căror mâini sunt nelegiuite și a căror dreaptă este plină de mită!"
    },
    {
      "number": 11,
      "text": "Eu umblu în neprihănire; izbăvește-mă și ai milă de mine!"
    },
    {
      "number": 12,
      "text": "Piciorul meu stă pe calea cea dreaptă: voi binecuvânta pe DOMNUL în adunări."
    }
  ],
