  "verses": [
    {
      "number": 1,
      "text": "(Către mai marele cântăreților. „Nu nimici.”"
    },
    {
      "number": 2,
      "text": "„Atunci când va veni vremea hotărâtă”, zice DOMNUL, „voi judeca fără părtinire.”"
    },
    {
      "number": 3,
      "text": "„Poate să se cutremure pământul cu locuitorii lui: căci Eu îi întăresc stâlpii.”"
    },
    {
      "number": 4,
      "text": "Eu zic celor ce se fălesc: „Nu vă făliți!”, și celor răi: „Nu ridicați capul sus!”"
    },
    {
      "number": 5,
      "text": "Nu vă ridicați capul așa de sus, nu vorbiți cu atâta trufie!"
    },
    {
      "number": 6,
      "text": "Căci nici de la Răsărit, nici de la Apus, nici din pustiu nu vine înălțarea."
    },
    {
      "number": 7,
      "text": "Ci Dumnezeu este Cel ce judecă: El coboară pe unul, și înalță pe altul."
    },
    {
      "number": 8,
      "text": "În mâna DOMNULUI este un potir, în care fierbe un vin plin de amestecătură. Când îl varsă, toți cei răi de pe pământ sug, îl sorb și-l beau până în fund!"
    },
    {
      "number": 9,
      "text": "Eu însă voi vesti pururi aceste lucruri; voi cânta laude în cinstea Dumnezeului lui Iacov."
    },
    {
      "number": 10,
      "text": "Și voi doborî toate puterile celor răi: puterile celui neprihănit însă se vor înălța."
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic"
