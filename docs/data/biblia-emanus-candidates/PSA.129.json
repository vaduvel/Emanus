  "verses": [
    {
      "number": 1,
      "text": "Destul m-au asuprit din tinerețe – s-o spună Israel! –"
    },
    {
      "number": 2,
      "text": "destul m-au asuprit din tinerețe, dar nu m-au biruit."
    },
    {
      "number": 3,
      "text": "Plugarii au arat pe spinarea mea, au tras brazde lungi pe ea."
    },
    {
      "number": 4,
      "text": "DOMNUL este drept: El a tăiat funiile celor răi."
    },
    {
      "number": 5,
      "text": "Să se umple de rușine și să dea înapoi toți cei ce urăsc Sionul!"
    },
    {
      "number": 6,
      "text": "Să fie ca iarba de pe acoperișuri, care se usucă înainte de a fi smulsă!"
    },
    {
      "number": 7,
      "text": "Secerătorul nu-și umple mâna cu ea, cel ce leagă snopii nu-și încarcă brațul cu ea,"
    },
    {
      "number": 8,
      "text": "și trecătorii nu zic: „Binecuvântarea DOMNULUI să fie peste voi!” „Vă binecuvântăm în Numele DOMNULUI!”"
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic",
  "superscription": "(O cântare a treptelor.)"
}
