  "verses": [
    {
      "number": 1,
      "text": "Dumnezeu să fie milostiv cu noi și să ne binecuvânteze; și să facă să strălucească fața lui peste noi; Selah."
    },
    {
      "number": 2,
      "text": "ca să se cunoască pe pământ calea Ta, și printre toate neamurile mântuirea Ta!"
    },
    {
      "number": 3,
      "text": "Te laudă popoarele, Dumnezeule, toate popoarele Te laudă."
    },
    {
      "number": 4,
      "text": "Se bucură neamurile și se înveselesc; căci Tu judeci popoarele cu nepărtinire și povățuiești neamurile pe pământ. – (Oprire)"
    },
    {
      "number": 5,
      "text": "Te laudă popoarele, Dumnezeule, toate popoarele Te laudă."
    },
    {
      "number": 6,
      "text": "Pământul își dă roadele; Dumnezeu, Dumnezeul nostru, ne binecuvântă,"
    },
    {
      "number": 7,
      "text": "Dumnezeu ne binecuvântă, și toate marginile pământului se tem de El."
    }
  ],
