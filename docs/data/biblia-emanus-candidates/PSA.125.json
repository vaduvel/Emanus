  "verses": [
    {
      "number": 1,
      "text": "Cei care își pun încrederea în DOMNUL seamănă cu muntele Sion: nu poate fi clătinat și rămâne pentru totdeauna."
    },
    {
      "number": 2,
      "text": "Așa cum munții înconjoară Ierusalimul, tot astfel DOMNUL Își ocrotește poporul, acum și în veci."
    },
    {
      "number": 3,
      "text": "Stăpânirea răutății nu va apăsa mereu peste partea celor drepți, ca nu cumva cei drepți să-și întindă mâinile spre nedreptate."
    },
    {
      "number": 4,
      "text": "DOAMNE, fă bine celor buni și celor cu inima dreaptă!"
    },
    {
      "number": 5,
      "text": "Iar pe cei care se abat pe căi strâmbe, DOMNUL îi va îndepărta împreună cu făptuitorii răului. Pace peste Israel!"
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic",
  "superscription": "(O cântare a treptelor.)"
