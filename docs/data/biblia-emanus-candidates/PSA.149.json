  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Cântați DOMNULUI o cântare nouă, cântați laudele Lui în adunarea credincioșilor Lui!"
    },
    {
      "number": 2,
      "text": "Să se bucure Israel de Cel ce l-a făcut, să se înveselească fiii Sionului de împăratul lor!"
    },
    {
      "number": 3,
      "text": "Să laude Numele Lui cu jocuri, să-L laude cu toba și cu harpa!"
    },
    {
      "number": 4,
      "text": "Căci DOMNUL are plăcere de poporul Său și slăvește pe cei nenorociți, mântuindu-i."
    },
    {
      "number": 5,
      "text": "Să salte de bucurie credincioșii Lui, îmbrăcați în slavă, să scoată strigăte de bucurie în așternutul lor!"
    },
    {
      "number": 6,
      "text": "Laudele lui Dumnezeu să fie în gura lor, și sabia cu două tăișuri, în mâna lor,"
    },
    {
      "number": 7,
      "text": "ca să facă răzbunare asupra neamurilor și să pedepsească popoarele;"
    },
    {
      "number": 8,
      "text": "să lege pe împărații lor cu lanțuri, și pe mai marii lor, cu obezi de fier,"
    },
    {
      "number": 9,
      "text": "ca să aducă la îndeplinire împotriva lor judecata scrisă! Aceasta este o cinste pentru toți credincioșii Lui. Lăudați pe DOMNUL!"
    }
  ],
