  "verses": [
    {
      "number": 1,
      "text": "Când a ieșit Israel din Egipt, când a plecat casa lui Iacov de la un popor străin,"
    },
    {
      "number": 2,
      "text": "Iuda a ajuns locașul Lui cel sfânt, și Israel, stăpânirea Lui."
    },
    {
      "number": 3,
      "text": "Marea a văzut lucrul acesta, și a fugit, Iordanul s-a întors înapoi:"
    },
    {
      "number": 4,
      "text": "munții au sărit ca niște berbeci, și dealurile, ca niște miei."
    },
    {
      "number": 5,
      "text": "Ce ai tu, mare, de fugi, și tu, Iordanule, de te întorci înapoi?"
    },
    {
      "number": 6,
      "text": "Ce aveți, munților, de săltați ca niște berbeci, și voi, dealurilor, ca niște miei?"
    },
    {
      "number": 7,
      "text": "Da, cutremură-te, pământule, înaintea DOMNULUI, înaintea Dumnezeului lui Iacov,"
    },
    {
      "number": 8,
      "text": "care preface stânca în iaz, și cremenea, în izvor de ape."
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic"
