  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Robii DOMNULUI, lăudați, lăudați Numele DOMNULUI!"
    },
    {
      "number": 2,
      "text": "Fie Numele DOMNULUI binecuvântat de acum și până în veac!"
    },
    {
      "number": 3,
      "text": "De la răsăritul soarelui până la apusul lui, fie Numele DOMNULUI lăudat."
    },
    {
      "number": 4,
      "text": "DOMNUL este înălțat mai presus de toate neamurile, slava Lui este mai presus de ceruri."
    },
    {
      "number": 5,
      "text": "Cine este ca DOMNUL Dumnezeul nostru care locuiește atât de sus?"
    },
    {
      "number": 6,
      "text": "El Își pleacă privirile să vadă ce se face în ceruri și pe pământ."
    },
    {
      "number": 7,
      "text": "El ridică pe sărac din țărână, înalță pe cel lipsit din gunoi,"
    },
    {
      "number": 8,
      "text": "ca să-i facă să șadă împreună cu cei mari: cu mai marii poporului Său."
    },
    {
      "number": 9,
      "text": "El dă o casă celei ce era stearpă, face din ea o mamă veselă în mijlocul copiilor ei. Lăudați pe DOMNUL!"
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic"
