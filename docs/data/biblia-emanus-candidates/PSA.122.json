  "verses": [
    {
      "number": 1,
      "text": "Mă bucur când mi se zice „Haidem la Casa DOMNULUI!”"
    },
    {
      "number": 2,
      "text": "Picioarele mi se opresc în porțile tale, Ierusalime!"
    },
    {
      "number": 3,
      "text": "Ierusalime, tu ești zidit ca o cetate făcută dintr-o bucată!"
    },
    {
      "number": 4,
      "text": "Acolo se suie semințiile, semințiile DOMNULUI, după legea lui Israel, ca să laude Numele DOMNULUI."
    },
    {
      "number": 5,
      "text": "Căci acolo sunt scaunele de domnie pentru judecată, scaunele de domnie ale casei lui David."
    },
    {
      "number": 6,
      "text": "Rugați-vă pentru pacea Ierusalimului! Cei ce te iubesc să se bucure de odihnă."
    },
    {
      "number": 7,
      "text": "Pacea să fie între zidurile tale, și liniștea, în casele tale domnești!"
    },
    {
      "number": 8,
      "text": "Din pricina fraților și prietenilor mei, doresc pacea în sânul tău."
    },
    {
      "number": 9,
      "text": "Din pricina Casei DOMNULUI Dumnezeului nostru, fac urări pentru fericirea ta."
    }
  ],
  "editorialNotes": [],
  "category": "Vechiul Testament Protocanonic",
  "superscription": "(O cântare a treptelor. Un psalm al lui David.)"
}
