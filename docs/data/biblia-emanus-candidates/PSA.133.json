  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor. Un psalm al lui David.) Iată, ce plăcut și ce dulce este să locuiască frații împreună!"
    },
    {
      "number": 2,
      "text": "Este ca untdelemnul de preț, care, turnat pe capul lui, se coboară pe barbă, pe barba lui Aaron, se coboară pe marginea veșmintelor lui."
    },
    {
      "number": 3,
      "text": "Este ca roua Hermonului care se coboară pe munții Sionului, căci acolo dă DOMNUL binecuvântarea, viața, pentru veșnicie."
    }
  ],
