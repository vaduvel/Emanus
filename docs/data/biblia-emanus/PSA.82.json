  "verses": [
    {
      "number": 1,
      "text": "„(Un psalm al lui Asaf.) Dumnezeu stă în adunarea lui Dumnezeu; El judecă în mijlocul dumnezeilor.”"
    },
    {
      "number": 2,
      "text": "– „Până când veți judeca strâmb și veți căuta la fața celor răi? – (Oprire)”"
    },
    {
      "number": 3,
      "text": "Faceți dreptate celui slab și orfanului, dați dreptate nenorocitului și săracului,"
    },
    {
      "number": 4,
      "text": "„scăpați pe cel nevoiaș și lipsit, izbăviți-i din mâna celor răi.”"
    },
    {
      "number": 5,
      "text": "Dar ei nu vor să știe de nimic, nu pricep nimic, ci umblă în întuneric; de aceea se clatină toate temeliile pământului."
    },
    {
      "number": 6,
      "text": "Eu am zis: „Sunteți dumnezei, toți sunteți fii ai Celui Preaînalt.”"
    },
    {
      "number": 7,
      "text": "„Însă veți muri ca niște oameni, veți cădea ca un domnitor oarecare.”"
    },
    {
      "number": 8,
      "text": "Scoală-Te, Dumnezeule, și judecă pământul! Căci toate neamurile sunt ale Tale."
    }
  ],
  "editorialNotes": []
