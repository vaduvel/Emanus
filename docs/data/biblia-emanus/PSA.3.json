  "verses": [
    {
      "number": 1,
      "text": "DOAMNE, ce mulți sunt vrăjmașii mei! Ce mulțime se scoală împotriva mea!"
    },
    {
      "number": 2,
      "text": "Cât de mulți zic despre mine: „Nu mai este scăpare pentru el la Dumnezeu!”"
    },
    {
      "number": 3,
      "text": "Dar, Tu, DOAMNE, Tu ești scutul meu, Tu ești slava mea și Tu îmi înalți capul!"
    },
    {
      "number": 4,
      "text": "Eu strig cu glasul meu către DOMNUL, și El îmi răspunde din muntele Lui cel sfânt. (Oprire)"
    },
    {
      "number": 5,
      "text": "Mă culc, adorm și mă deștept iarăși, căci DOMNUL este sprijinul meu."
    },
    {
      "number": 6,
      "text": "Nu mă tem de zecile de mii de popoare care mă împresoară din toate părțile."
    },
    {
      "number": 7,
      "text": "Scoală-Te, DOAMNE! Scapă-mă, Dumnezeule! Căci Tu bați peste obraz pe toți vrăjmașii mei și zdrobești dinții celor răi."
    },
    {
      "number": 8,
      "text": "La DOMNUL este scăparea: binecuvântarea Ta să fie peste poporul Tău. (Oprire)"
    }
  ],
