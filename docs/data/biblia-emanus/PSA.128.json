  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor.) Ferice de oricine se teme de DOMNUL și umblă pe căile Lui!"
    },
    {
      "number": 2,
      "text": "Căci atunci te bucuri de lucrul mâinilor tale, ești fericit și-ți merge bine."
    },
    {
      "number": 3,
      "text": "Nevasta ta este ca o viță roditoare înăuntrul casei tale; copiii tăi stau ca niște lăstari de măslin împrejurul mesei tale."
    },
    {
      "number": 4,
      "text": "Așa este binecuvântat omul care se teme de DOMNUL."
    },
    {
      "number": 5,
      "text": "Să te binecuvânteze DOMNUL din Sion, să vezi fericirea Ierusalimului, în toate zilele vieții tale,"
    },
    {
      "number": 6,
      "text": "și să vezi pe copiii copiilor tăi! Pacea să fie peste Israel!"
    }
  ],
