  "verses": [
    {
      "number": 1,
      "text": "Când a adus DOMNUL înapoi pe prinșii de război ai Sionului, parcă visam."
    },
    {
      "number": 2,
      "text": "Atunci gura ne era plină de strigăte de bucurie, și limba, de cântări de veselie. Atunci se spunea printre neamuri: „DOMNUL a făcut mari lucruri pentru ei!”"
    },
    {
      "number": 3,
      "text": "Da, DOMNUL a făcut mari lucruri pentru noi, și de aceea suntem plini de bucurie."
    },
    {
      "number": 4,
      "text": "DOAMNE, adu înapoi pe prinșii noștri de război, ca pe niște râuri în partea de miazăzi!"
    },
    {
      "number": 5,
      "text": "Cei ce seamănă cu lacrimi vor secera cu cântări de veselie."
    },
    {
      "number": 6,
      "text": "Cel ce umblă plângând, când aruncă sămânța, se întoarce cu veselie când își strânge snopii."
    }
  ],
