  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor.) Îmi ridic ochii spre munți… De unde-mi va veni ajutorul?"
    },
    {
      "number": 2,
      "text": "Ajutorul îmi vine de la DOMNUL, care a făcut cerurile și pământul."
    },
    {
      "number": 3,
      "text": "Da, El nu va îngădui să ți se clatine piciorul; Cel ce te păzește nu va dormita."
    },
    {
      "number": 4,
      "text": "Iată că nu dormitează, nici nu doarme Cel ce păzește pe Israel."
    },
    {
      "number": 5,
      "text": "DOMNUL este păzitorul tău, DOMNUL este umbra ta pe mâna ta cea dreaptă."
    },
    {
      "number": 6,
      "text": "De aceea nu te va bate soarele ziua, nici luna noaptea."
    },
    {
      "number": 7,
      "text": "DOMNUL te va păzi de orice rău, îți va păzi sufletul."
    },
    {
      "number": 8,
      "text": "DOMNUL te va păzi la plecare și la venire, de acum și până în veac."
    }
  ],
