  "verses": [
    {
      "number": 1,
      "text": "Către DOMNUL strig în strâmtorarea mea, și El m-ascultă."
    },
    {
      "number": 2,
      "text": "DOAMNE, scapă-mi sufletul de buza mincinoasă, de limba înșelătoare!"
    },
    {
      "number": 3,
      "text": "Ce-ți dă El ție, ce-ți aduce El ție, limbă înșelătoare?"
    },
    {
      "number": 4,
      "text": "Săgeți ascuțite de războinic cu cărbuni aprinși de ienupăr."
    },
    {
      "number": 5,
      "text": "Vai de mine că locuiesc la Meșec, că locuiesc în corturile Chedarului!"
    },
    {
      "number": 6,
      "text": "Destul mi-a locuit sufletul lângă cei ce urăsc pacea."
    },
    {
      "number": 7,
      "text": "Eu sunt pentru pace; dar de îndată ce vorbesc eu, ei sunt pentru război."
    }
  ],
