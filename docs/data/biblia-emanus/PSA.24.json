  "verses": [
    {
      "number": 1,
      "text": "(Un psalm al lui David.) Al DOMNULUI este pământul cu tot ce este pe el, lumea și cei ce o locuiesc!"
    },
    {
      "number": 2,
      "text": "Căci El l-a întemeiat pe mări și l-a întărit pe râuri."
    },
    {
      "number": 3,
      "text": "Cine va putea să se suie la muntele DOMNULUI? Cine se va ridica până la locul Lui cel sfânt? –"
    },
    {
      "number": 4,
      "text": "Cel ce are mâinile nevinovate și inima curată, cel ce nu-și dedă sufletul la minciună și nu jură ca să înșele."
    },
    {
      "number": 5,
      "text": "Acela va căpăta binecuvântarea DOMNULUI, starea după voia Lui dată de Dumnezeul mântuirii lui."
    },
    {
      "number": 6,
      "text": "Iată partea de moștenire a celor ce-L cheamă, a celor ce caută fața Ta, Dumnezeul lui Iacov. – (Oprire)"
    },
    {
      "number": 7,
      "text": "Porți, ridicați-vă capetele; ridicați-vă, porți veșnice, ca să intre Împăratul slavei! –"
    },
    {
      "number": 8,
      "text": "„Cine este acest Împărat al slavei?”"
    },
    {
      "number": 9,
      "text": "Porți, ridicați-vă capetele; ridicați-le, porți veșnice, ca să intre Împăratul slavei! –"
    },
    {
      "number": 10,
      "text": "„Cine este acest Împărat al slavei?”"
    }
  ],
