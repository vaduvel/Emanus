  "verses": [
    {
      "number": 1,
      "text": "Fiii celor puternici, dați DOMNULUI, dați DOMNULUI slavă și putere."
    },
    {
      "number": 2,
      "text": "Dați DOMNULUI slava cuvenită Numelui Lui! Închinați-vă înaintea DOMNULUI îmbrăcați cu podoabe sfinte!"
    },
    {
      "number": 3,
      "text": "Glasul DOMNULUI răsună pe ape, Dumnezeul slavei face să bubuie tunetul: DOMNUL este pe ape mari."
    },
    {
      "number": 4,
      "text": "Glasul DOMNULUI este puternic, glasul DOMNULUI este măreț."
    },
    {
      "number": 5,
      "text": "Glasul DOMNULUI sfărâmă cedrii; DOMNUL sfărâmă cedrii Libanului;"
    },
    {
      "number": 6,
      "text": "îi face să sară ca niște viței, iar Libanul și Sirionul ca niște pui de bou sălbatic."
    },
    {
      "number": 7,
      "text": "Glasul DOMNULUI lovește cu fulgere,"
    },
    {
      "number": 8,
      "text": "glasul DOMNULUI face să se cutremure pustiul; DOMNUL face să tremure pustiul Cades."
    },
    {
      "number": 9,
      "text": "Glasul DOMNULUI face pe cerboaice să nască; El despoaie pădurile; în locașul Lui totul strigă: „Slavă!”"
    },
    {
      "number": 10,
      "text": "DOMNUL stătea pe scaunul Lui de domnie când cu potopul, și DOMNUL împărățește în veci pe scaunul Lui de domnie."
    },
    {
      "number": 11,
      "text": "DOMNUL dă tărie poporului Său, DOMNUL binecuvântă pe poporul Său cu pace."
    }
  ],
