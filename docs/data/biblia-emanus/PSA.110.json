  "verses": [
    {
      "number": 1,
      "text": "DOMNUL a zis DOMNULUI meu: „Șezi la dreapta Mea, până voi pune pe vrăjmașii Tăi sub picioarele Tale.”"
    },
    {
      "number": 2,
      "text": "DOMNUL va întinde din Sion toiagul de cârmuire al puterii Tale, zicând: „Stăpânește în mijlocul vrăjmașilor Tăi!”"
    },
    {
      "number": 3,
      "text": "Poporul Tău este plin de înflăcărare, când Îți aduni oștirea; cu podoabe sfinte, ca din sânul zorilor, vine tineretul Tău la Tine, ca roua."
    },
    {
      "number": 4,
      "text": "DOMNUL a jurat, și nu-I va părea rău: „Tu ești preot în veac, în felul lui Melhisedec.”"
    },
    {
      "number": 5,
      "text": "DOMNUL, de la dreapta Ta, zdrobește pe împărați în ziua mâniei Lui."
    },
    {
      "number": 6,
      "text": "El va judeca printre neamuri: totul este plin de trupuri moarte; El va zdrobi capul peste un pământ întins."
    },
    {
      "number": 7,
      "text": "El bea din pârâu în timpul mersului: de aceea Își înalță capul."
    }
  ],
