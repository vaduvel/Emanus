  "verses": [
    {
      "number": 1,
      "text": "Te laud din toată inima, cânt laudele Tale înaintea dumnezeilor."
    },
    {
      "number": 2,
      "text": "Mă închin în Templul Tău cel sfânt și laud Numele Tău, pentru bunătatea și credincioșia Ta, căci Ți s-a mărit faima prin împlinirea făgăduințelor Tale."
    },
    {
      "number": 3,
      "text": "În ziua când Te-am chemat, m-ai ascultat, m-ai îmbărbătat și mi-ai întărit sufletul."
    },
    {
      "number": 4,
      "text": "Toți împărații pământului Te vor lăuda, DOAMNE, când vor auzi cuvintele gurii Tale;"
    },
    {
      "number": 5,
      "text": "ei vor lăuda căile DOMNULUI, căci mare este slava DOMNULUI!"
    },
    {
      "number": 6,
      "text": "DOMNUL este înălțat: totuși vede pe cei smeriți și cunoaște de departe pe cei îngâmfați."
    },
    {
      "number": 7,
      "text": "Când umblu în mijlocul strâmtorării, Tu mă înviorezi, Îți întinzi mâna spre mânia vrăjmașilor mei, și dreapta Ta mă mântuiește."
    },
    {
      "number": 8,
      "text": "DOMNUL va sfârși ce a început pentru mine. DOAMNE, bunătatea Ta ține în veci: nu părăsi lucrările mâinilor Tale."
    }
  ],
