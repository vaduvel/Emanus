  "verses": [
    {
      "number": 1,
      "text": "Iată, binecuvântați pe DOMNUL, toți robii DOMNULUI, care stați noaptea în Casa DOMNULUI!"
    },
    {
      "number": 2,
      "text": "Ridicați-vă mâinile spre Sfântul Locaș și binecuvântați pe DOMNUL!"
    },
    {
      "number": 3,
      "text": "DOMNUL să te binecuvânteze din Sion, El, care a făcut cerurile și pământul!"
    }
