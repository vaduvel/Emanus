  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Voi lăuda pe DOMNUL din toată inima mea, în tovărășia oamenilor fără prihană și în adunare."
    },
    {
      "number": 2,
      "text": "Mari sunt lucrările DOMNULUI, cercetate de toți cei ce le iubesc."
    },
    {
      "number": 3,
      "text": "Strălucire și măreție este lucrarea Lui, și dreptatea Lui ține în veci."
    },
    {
      "number": 4,
      "text": "El a lăsat o aducere aminte a minunilor Lui, DOMNUL este îndurător și milostiv."
    },
    {
      "number": 5,
      "text": "El a dat hrană celor ce se tem de El; El Își aduce pururi aminte de legământul Lui."
    },
    {
      "number": 6,
      "text": "El a arătat poporului Său puterea lucrărilor Lui, căci le-a dat moștenirea neamurilor."
    },
    {
      "number": 7,
      "text": "Lucrările mâinilor Lui sunt credincioșie și dreptate; toate poruncile Lui sunt adevărate,"
    },
    {
      "number": 8,
      "text": "întărite pentru veșnicie, făcute cu credincioșie și neprihănire."
    },
    {
      "number": 9,
      "text": "A trimis poporului Său izbăvirea, a așezat legământul Său în veci; Numele Lui este sfânt și înfricoșat."
    },
    {
      "number": 10,
      "text": "Frica DOMNULUI este începutul înțelepciunii; toți cei ce o păzesc au o minte sănătoasă, și slava Lui ține în veci."
    }
  ],
