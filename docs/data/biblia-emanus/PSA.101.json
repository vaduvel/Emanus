  "verses": [
    {
      "number": 1,
      "text": "Voi cânta bunătatea și dreptatea; Ție, DOAMNE, Îți voi cânta."
    },
    {
      "number": 2,
      "text": "Mă voi purta cu înțelepciune pe o cale neprihănită. – Când vei veni la mine? – Voi umbla cu inima fără prihană în mijlocul casei mele."
    },
    {
      "number": 3,
      "text": "Nu voi pune nimic rău înaintea ochilor mei; urăsc purtarea păcătoșilor; ea nu se va lipi de mine."
    },
    {
      "number": 4,
      "text": "Inima stricată se va depărta de mine; nu vreau să cunosc pe cel rău."
    },
    {
      "number": 5,
      "text": "Pe cel ce clevetește în ascuns pe aproapele său, îl voi nimici; pe cel cu priviri trufașe și cu inima îngâmfată, nu-l voi suferi."
    },
    {
      "number": 6,
      "text": "Voi avea ochii îndreptați asupra credincioșilor din țară, ca să locuiască lângă mine; cel ce umblă pe o cale fără prihană, acela îmi va sluji."
    },
    {
      "number": 7,
      "text": "Cel ce se dedă la înșelăciune nu va locui în casa mea; cel ce spune minciuni nu va sta înaintea mea."
    },
    {
      "number": 8,
      "text": "În fiecare dimineață voi nimici pe toți cei răi din țară, ca să stârpesc din cetatea DOMNULUI pe toți cei ce săvârșesc nelegiuirea."
    }
  ],
