  "verses": [
    {
      "number": 1,
      "text": "Dacă nu zidește DOMNUL o casă, degeaba lucrează cei ce o zidesc; dacă nu păzește DOMNUL o cetate, degeaba veghează cel ce o păzește."
    },
    {
      "number": 2,
      "text": "Degeaba vă sculați de dimineață și vă culcați târziu, ca să mâncați pâinea muncii; căci El dă somn preaiubitului Său."
    },
    {
      "number": 3,
      "text": "Iată, fiii sunt o moștenire de la DOMNUL, rodul pântecelui este o răsplată dată de El."
    },
    {
      "number": 4,
      "text": "Ca săgețile în mâna unui războinic așa sunt fiii făcuți la tinerețe."
    },
    {
      "number": 5,
      "text": "Ferice de omul care își umple tolba de săgeți cu ei! Căci ei nu vor rămâne de rușine când vor vorbi cu vrăjmașii lor la poartă."
    }
  ],
