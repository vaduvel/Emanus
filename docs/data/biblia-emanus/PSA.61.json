  "verses": [
    {
      "number": 1,
      "text": "Ascultă, Dumnezeule, strigătele mele, ia aminte la rugăciunea mea!"
    },
    {
      "number": 2,
      "text": "De la capătul pământului strig către Tine cu inima mâhnită și zic: „Du-mă pe stânca pe care n-o pot ajunge, căci este prea înaltă pentru mine!”"
    },
    {
      "number": 3,
      "text": "Căci Tu ești un adăpost pentru mine, un turn tare împotriva vrăjmașului."
    },
    {
      "number": 4,
      "text": "Aș vrea să locuiesc pe vecie în cortul Tău, să alerg la adăpostul aripilor Tale. – (Oprire)"
    },
    {
      "number": 5,
      "text": "Căci Tu, Dumnezeule, îmi asculți juruințele, Tu îmi dai moștenirea celor ce se tem de Numele Tău."
    },
    {
      "number": 6,
      "text": "Tu adaugi zile la zilele împăratului; anii lui să fie ca din neam în neam!"
    },
    {
      "number": 7,
      "text": "În veci să rămână el pe scaunul de domnie, înaintea lui Dumnezeu! Fă ca bunătatea și credincioșia Ta să vegheze asupra lui!"
    },
    {
      "number": 8,
      "text": "„Atunci voi cânta neîncetat Numele Tău, și zi de zi îmi voi împlini juruințele.”"
    }
  ],
