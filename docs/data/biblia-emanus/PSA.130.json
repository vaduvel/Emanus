  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor.) Din fundul adâncului, Te chem, DOAMNE!"
    },
    {
      "number": 2,
      "text": "DOAMNE, ascultă-mi glasul! Să ia aminte urechile Tale la glasul cererilor mele!"
    },
    {
      "number": 3,
      "text": "Dacă ai păstra, DOAMNE, aducerea aminte a nelegiuirilor, cine ar putea sta în picioare, DOAMNE?"
    },
    {
      "number": 4,
      "text": "Dar la Tine este iertare, ca să fii de temut."
    },
    {
      "number": 5,
      "text": "Eu nădăjduiesc în DOMNUL, sufletul meu nădăjduiește, și aștept făgăduința Lui."
    },
    {
      "number": 6,
      "text": "Sufletul meu așteaptă pe DOMNUL mai mult decât așteaptă străjerii dimineața, da, mai mult decât așteaptă străjerii dimineața."
    },
    {
      "number": 7,
      "text": "Israele, pune-ți nădejdea în DOMNUL, căci la DOMNUL este îndurarea și la El este belșug de răscumpărare!"
    },
    {
      "number": 8,
      "text": "El va răscumpăra pe Israel din toate nelegiuirile lui."
    }
  ],
