  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Lăudați pe Dumnezeu în Locașul Lui cel Sfânt, lăudați-L în întinderea cerului, unde se arată puterea Lui!"
    },
    {
      "number": 2,
      "text": "Lăudați-L pentru isprăvile Lui cele mari, lăudați-L, după mărimea Lui nemărginită!"
    },
    {
      "number": 3,
      "text": "Lăudați-L cu sunet de trâmbiță, lăudați-L cu lăuta și harpa!"
    },
    {
      "number": 4,
      "text": "Lăudați-L cu timpane și cu jocuri, lăudați-L cântând cu instrumente cu corzi și cu cavalul."
    },
    {
      "number": 5,
      "text": "Lăudați-L cu chimvale sunătoare, lăudați-L cu chimvale zăngănitoare!"
    },
    {
      "number": 6,
      "text": "Tot ce are suflare să laude pe DOMNUL! Lăudați pe DOMNUL!"
    }
  ],
