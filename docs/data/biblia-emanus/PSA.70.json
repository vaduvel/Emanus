  "verses": [
    {
      "number": 1,
      "text": "Grăbește, Dumnezeule, de mă izbăvește! Grăbește de-mi ajută, DOAMNE!"
    },
    {
      "number": 2,
      "text": "Să rămână de rușine și înfruntați cei ce vor să-mi ia viața! Să dea înapoi și să roșească cei ce-mi doresc pieirea!"
    },
    {
      "number": 3,
      "text": "Să se întoarcă înapoi de rușine cei ce zic: „Aha! Aha!”"
    },
    {
      "number": 4,
      "text": "Toți cei ce Te caută să se înveselească și să se bucure în Tine! Cei ce iubesc mântuirea Ta să zică neîncetat: „Preamărit să fie Dumnezeu!”"
    },
    {
      "number": 5,
      "text": "Eu sunt sărac și lipsit: grăbește să-mi ajuți, Dumnezeule. Tu ești ajutorul și izbăvitorul meu: DOAMNE, nu zăbovi!"
    }
  ],
