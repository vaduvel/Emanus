  "verses": [
    {
      "number": 1,
      "text": "(Către mai marele cântăreților. Un psalm al lui David.) Până când, DOAMNE, mă vei uita neîncetat? Până când Îți vei ascunde fața de mine?"
    },
    {
      "number": 2,
      "text": "Până când voi avea sufletul plin de griji și inima plină de necazuri în fiecare zi? Până când se va ridica vrăjmașul meu împotriva mea?"
    },
    {
      "number": 3,
      "text": "Privește, răspunde-mi, DOAMNE Dumnezeul meu! Dă lumină ochilor mei, ca să n-adorm somnul morții,"
    },
    {
      "number": 4,
      "text": "ca să nu zică vrăjmașul meu: „L-am biruit!”"
    },
    {
      "number": 5,
      "text": "Eu am încredere în bunătatea Ta, sunt cu inima veselă, din pricina mântuirii Tale:"
    },
    {
      "number": 6,
      "text": "cânt DOMNULUI, căci mi-a făcut bine!"
    }
  ],
