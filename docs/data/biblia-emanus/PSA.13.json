  "verses": [
    {
      "number": 1,
      "text": "Până când, DOAMNE, mă vei uita pentru totdeauna? Până când Îți vei ascunde fața de mine?"
    },
    {
      "number": 2,
      "text": "Până când voi ține sfat în sufletul meu, având întristare în inimă în fiecare zi? Până când va triumfa vrăjmașul meu asupra mea?"
    },
    {
      "number": 3,
      "text": "Privește, răspunde-mi, DOAMNE Dumnezeul meu! Dă lumină ochilor mei, ca să n-adorm somnul morții,"
    },
    {
      "number": 4,
      "text": "ca să nu spună vrăjmașul meu: „L-am biruit!” și potrivnicii mei să nu se bucure când mă clatin."
    },
    {
      "number": 5,
      "text": "Eu am încredere în bunătatea Ta, sunt cu inima veselă, din pricina mântuirii Tale:"
    },
    {
      "number": 6,
      "text": "cânt DOMNULUI, căci mi-a făcut bine!"
    }
  ],
