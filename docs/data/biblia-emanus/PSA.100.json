  "verses": [
    {
      "number": 1,
      "text": "Strigați de bucurie către DOMNUL, toți locuitorii pământului!"
    },
    {
      "number": 2,
      "text": "Slujiți DOMNULUI cu bucurie, veniți cu veselie înaintea Lui."
    },
    {
      "number": 3,
      "text": "Să știți că DOMNUL este Dumnezeu! El ne-a făcut, ai Lui suntem: noi suntem poporul Lui și turma pășunii Lui."
    },
    {
      "number": 4,
      "text": "Intrați cu laude pe porțile Lui, intrați cu cântări în curțile Lui! Lăudați-L și binecuvântați-I Numele."
    },
    {
      "number": 5,
      "text": "Căci DOMNUL este bun; bunătatea Lui ține în veci, și credincioșia Lui, din neam în neam."
    }
  ],
