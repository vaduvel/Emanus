  "verses": [
    {
      "number": 1,
      "text": "Sionul are temeliile așezate pe munții cei sfinți:"
    },
    {
      "number": 2,
      "text": "DOMNUL iubește porțile Sionului mai mult decât toate locașurile lui Iacov."
    },
    {
      "number": 3,
      "text": "Lucruri pline de slavă au fost spuse despre tine, cetate a lui Dumnezeu! – (Oprire)"
    },
    {
      "number": 4,
      "text": "Eu pomenesc Egiptul și Babilonul printre cei ce Mă cunosc; iată, țara filistenilor, Tirul cu Etiopia: „În Sion s-au născut.”"
    },
    {
      "number": 5,
      "text": "Iar despre Sion este zis: „Toți s-au născut în el”"
    },
    {
      "number": 6,
      "text": "DOMNUL numără popoarele, scriindu-le: „Acolo s-au născut.”"
    },
    {
      "number": 7,
      "text": "Și cei ce cântă și cei ce joacă strigă: „Toate izvoarele mele sunt în Tine.”"
    }
  ],
