  "verses": [
    {
      "number": 1,
      "text": "DOAMNE, eu n-am o inimă îngâmfată, nici priviri trufașe, nu mă îndeletnicesc cu lucruri prea mari și prea înalte pentru mine."
    },
    {
      "number": 2,
      "text": "Dimpotrivă, sufletul îmi este liniștit și potolit ca un copil înțărcat care stă lângă mama sa; da, sufletul meu este ca un copil înțărcat."
    },
    {
      "number": 3,
      "text": "Pune-ți nădejdea în DOMNUL, Israele, de acum și până în veac!"
    }
  ],
