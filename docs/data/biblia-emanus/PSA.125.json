  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor.) Cei ce se încred în DOMNUL sunt ca muntele Sionului care nu se clatină, ci stă întărit pe vecie."
    },
    {
      "number": 2,
      "text": "Cum este înconjurat Ierusalimul de munți, așa înconjoară DOMNUL pe poporul Său, de acum și până în veac."
    },
    {
      "number": 3,
      "text": "Căci toiagul de cârmuire al răutății nu va rămâne pe moștenirea celor neprihăniți, pentru ca cei neprihăniți să nu întindă mâinile spre nelegiuire."
    },
    {
      "number": 4,
      "text": "DOAMNE, varsă-Ți binefacerile peste cei buni și peste cei cu inima fără prihană!"
    },
    {
      "number": 5,
      "text": "Dar pe cei ce apucă pe căi lăturalnice, să-i nimicească DOMNUL împreună cu cei ce fac rău! Pacea să fie peste Israel!"
    }
  ],
