  "verses": [
    {
      "number": 1,
      "text": "Bateți din palme toate popoarele! Strigați lui Dumnezeu cu glasul biruinței!"
    },
    {
      "number": 2,
      "text": "Căci DOMNUL, Cel Preaînalt, este înfricoșat: El este Împărat mare peste tot pământul."
    },
    {
      "number": 3,
      "text": "El ne supune popoarele, El pune neamurile sub picioarele noastre."
    },
    {
      "number": 4,
      "text": "El ne alege moștenirea, slava lui Iacov, pe care-l iubește. – (Oprire)"
    },
    {
      "number": 5,
      "text": "Dumnezeu Se suie în mijlocul strigătelor de biruință, DOMNUL înaintează în sunetul trâmbiței."
    },
    {
      "number": 6,
      "text": "Cântați lui Dumnezeu, cântați! Cântați Împăratului nostru, cântați!"
    },
    {
      "number": 7,
      "text": "Căci Dumnezeu este Împărat peste tot pământul; cântați cu înțelegere!"
    },
    {
      "number": 8,
      "text": "Dumnezeu împărățește peste neamuri, Dumnezeu șade pe scaunul Lui de domnie cel sfânt."
    },
    {
      "number": 9,
      "text": "Domnitorii popoarelor se adună împreună cu poporul Dumnezeului lui Avraam; căci ale lui Dumnezeu sunt scuturile pământului: El este mai înalt și mai presus de orice."
    }
  ],
