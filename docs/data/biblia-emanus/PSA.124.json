  "verses": [
    {
      "number": 1,
      "text": "Israel să mărturisească acum: dacă DOMNUL nu ar fi fost alături de noi,"
    },
    {
      "number": 2,
      "text": "dacă DOMNUL nu ar fi fost alături de noi când oamenii s-au ridicat împotriva noastră,"
    },
    {
      "number": 3,
      "text": "atunci ne-ar fi înghițit de vii, când mânia lor ardea împotriva noastră;"
    },
    {
      "number": 4,
      "text": "atunci apele ne-ar fi acoperit, iar șuvoiul ar fi trecut peste sufletul nostru;"
    },
    {
      "number": 5,
      "text": "da, apele învolburate ar fi trecut peste sufletul nostru."
    },
    {
      "number": 6,
      "text": "Binecuvântat este DOMNUL, care nu ne-a lăsat pradă dinților lor!"
    },
    {
      "number": 7,
      "text": "Sufletul nostru a scăpat asemenea unei păsări din cursa vânătorilor; cursa s-a sfărâmat, iar noi am scăpat."
    },
    {
      "number": 8,
      "text": "Sprijinul nostru vine din Numele DOMNULUI, Făcătorul cerului și al pământului."
    }
  ],
