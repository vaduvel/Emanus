  "verses": [
    {
      "number": 1,
      "text": "(O cântare a treptelor. Un psalm al lui David.) De n-ar fi fost DOMNUL de partea noastră – să spună Israel acum! –"
    },
    {
      "number": 2,
      "text": "de n-ar fi fost DOMNUL de partea noastră când s-au ridicat oamenii împotriva noastră,"
    },
    {
      "number": 3,
      "text": "ne-ar fi înghițit de vii, când li s-a aprins mânia împotriva noastră;"
    },
    {
      "number": 4,
      "text": "ne-ar fi înecat apele, ar fi trecut râurile peste sufletul nostru;"
    },
    {
      "number": 5,
      "text": "ar fi trecut peste sufletul nostru valurile năprasnice."
    },
    {
      "number": 6,
      "text": "Binecuvântat să fie DOMNUL, care nu ne-a dat pradă dinților lor!"
    },
    {
      "number": 7,
      "text": "Sufletul ne-a scăpat ca pasărea din lațul păsărarului; lațul s-a rupt, și noi am scăpat."
    },
    {
      "number": 8,
      "text": "Ajutorul nostru este în Numele DOMNULUI, care a făcut cerurile și pământul."
    }
  ],
  "editorialNotes": []
