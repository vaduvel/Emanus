  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Laudă, suflete, pe DOMNUL!"
    },
    {
      "number": 2,
      "text": "Voi lăuda pe DOMNUL cât voi trăi, voi lăuda pe Dumnezeul meu cât voi fi."
    },
    {
      "number": 3,
      "text": "Nu vă încredeți în cei mari, în fiii oamenilor, în care nu este ajutor."
    },
    {
      "number": 4,
      "text": "Suflarea lor trece, se întorc în pământ, și în aceeași zi le pier și planurile lor."
    },
    {
      "number": 5,
      "text": "Ferice de cine are ca ajutor pe Dumnezeul lui Iacov, ferice de cine-și pune nădejdea în DOMNUL Dumnezeul său!"
    },
    {
      "number": 6,
      "text": "El a făcut cerurile și pământul, marea și tot ce este în ea. El ține credincioșia în veci."
    },
    {
      "number": 7,
      "text": "El face dreptate celor asupriți; dă pâine celor flămânzi: DOMNUL izbăvește pe prinșii de război;"
    },
    {
      "number": 8,
      "text": "DOMNUL deschide ochii orbilor; DOMNUL îndreaptă pe cei încovoiați; DOMNUL iubește pe cei neprihăniți."
    },
    {
      "number": 9,
      "text": "DOMNUL ocrotește pe cei străini, sprijină pe orfan și pe văduvă, dar răstoarnă calea celor răi."
    },
    {
      "number": 10,
      "text": "DOMNUL împărățește în veci; Dumnezeul tău, Sioane, rămâne din veac în veac! Lăudați pe DOMNUL!"
    }
  ],
