  "verses": [
    {
      "number": 1,
      "text": "Lăudați pe DOMNUL! Ferice de omul care se teme de DOMNUL și care are o mare plăcere pentru poruncile Lui!"
    },
    {
      "number": 2,
      "text": "Sămânța lui va fi puternică pe pământ; neamul oamenilor fără prihană va fi binecuvântat."
    },
    {
      "number": 3,
      "text": "El are în casă bogăție și belșug, și neprihănirea lui dăinuie în veci."
    },
    {
      "number": 4,
      "text": "Celui fără prihană îi răsare lumina în întuneric; el este milostiv, îndurător și drept."
    },
    {
      "number": 5,
      "text": "Ce bine-i merge omului care este milostiv și împrumută, care își rânduiește pricina la judecată!"
    },
    {
      "number": 6,
      "text": "Căci el nu se clatină niciodată; pomenirea celui neprihănit ține în veci."
    },
    {
      "number": 7,
      "text": "El nu se teme de vești rele, ci inima lui este tare, încrezătoare în DOMNUL."
    },
    {
      "number": 8,
      "text": "Inima lui este tare; nu se teme până când își vede potrivnicii."
    },
    {
      "number": 9,
      "text": "El este darnic, dă celor lipsiți; neprihănirea lui dăinuie în veci; cornul lui se înalță cu slavă."
    },
    {
      "number": 10,
      "text": "Cel rău vede lucrul acesta și se mânie, scrâșnește din dinți și se topește. Poftele celor răi rămân neîmplinite."
    }
  ],
