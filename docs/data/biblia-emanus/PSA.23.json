  "verses": [
    {
      "number": 1,
      "text": "DOMNUL este păstorul meu: nu voi duce lipsă de nimic."
    },
    {
      "number": 2,
      "text": "El mă paște în pășuni verzi și mă duce la ape de odihnă;"
    },
    {
      "number": 3,
      "text": "îmi înviorează sufletul și mă povățuiește pe cărări drepte, din pricina Numelui Său."
    },
    {
      "number": 4,
      "text": "Chiar dacă ar fi să umblu prin valea umbrei morții, nu mă tem de niciun rău, căci Tu ești cu mine. Toiagul și nuiaua Ta mă mângâie."
    },
    {
      "number": 5,
      "text": "Tu îmi întinzi masa în fața potrivnicilor mei; îmi ungi capul cu untdelemn, și paharul meu este plin de dă peste el."
    },
    {
      "number": 6,
      "text": "Da, bunătatea și îndurarea mă vor însoți în toate zilele vieții mele, și voi locui în Casa DOMNULUI pentru totdeauna."
    }
  ],
