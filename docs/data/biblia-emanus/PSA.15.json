  "verses": [
    {
      "number": 1,
      "text": "DOAMNE, cine va locui în cortul Tău? Cine va locui pe muntele Tău cel sfânt?"
    },
    {
      "number": 2,
      "text": "– Cel ce umblă în neprihănire, cel ce face voia lui Dumnezeu și spune adevărul din inimă."
    },
    {
      "number": 3,
      "text": "Acela nu clevetește cu limba lui, nu face rău semenului său și nu aruncă ocara asupra aproapelui său."
    },
    {
      "number": 4,
      "text": "El privește cu dispreț pe cel vrednic de disprețuit, dar cinstește pe cei ce se tem de DOMNUL. El nu-și ia vorba înapoi dacă face un jurământ în paguba lui."
    },
    {
      "number": 5,
      "text": "El nu-și dă banii cu dobândă și nu ia mită împotriva celui nevinovat. Cel ce se poartă așa, nu se clatină niciodată."
    }
  ],
