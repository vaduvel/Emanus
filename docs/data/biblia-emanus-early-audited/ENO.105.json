  "verses": [
    {
      "number": 1,
      "text": "În zilele acelea, Domnul le-a poruncit să cheme să mărturisească fiilor pământului despre înțelepciunea lor: Arăt-le-o, căci voi călăuzele lor o răsplată pentru tot pământul."
    },
    {
      "number": 2,
      "text": "Căci Eu și Fiul Meu vom fi uniți cu ei pentru totdeauna pe cărări drepte în viața lor; și veți avea pace; bucurați-vă, fii de dreptate. Amin."
    }
  ],
