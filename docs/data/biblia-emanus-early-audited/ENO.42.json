  "verses": [
    {
      "number": 1,
      "text": "Înțelepciunea n'a găsit nici un loc unde să locuiască, și i s'a dat un loc de locuit în ceruri."
    },
    {
      "number": 2,
      "text": "Înțelepciunea a ieșit ca să locuiască printre copiii oamenilor, n-a găsit nici o; înțelepciunea s-a întors la locul ei, -a locul printre îngeri."
    },
    {
      "number": 3,
      "text": "Neprihănirea a ieșit din odăile ei. Ea n'a căutat pe cine n'a găsit, și a locuit cu ei, ca ploaia într'un pustiu, și roua pe o țară însetată."
    }
  ],
