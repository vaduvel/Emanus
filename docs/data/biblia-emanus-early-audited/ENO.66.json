  "verses": [
    {
      "number": 1,
      "text": "Și după aceea mi-a arătat îngerii osândei, care sunt gata să vină să dezlege toate puterile apelor care sunt dedesubt pe pământ, pentru a aduce judecata distrugerea asupra tuturor celor care locuiesc pe pământ."
    },
    {
      "number": 2,
      "text": "Și Domnul spiritelor a poruncit îngerilor care ieșeau să nu facă să crească apele, ci să le sub control, pentru că acei îngeri erau peste puterile apelor."
    },
    {
      "number": 3,
      "text": "Și am plecat departe de prezența lui Enoh."
    }
  ],
