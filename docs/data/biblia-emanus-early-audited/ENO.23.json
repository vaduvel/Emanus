  "verses": [
    {
      "number": 1,
      "text": "De acolo m-am dus într-un alt loc la vest de marginile pământului."
    },
    {
      "number": 2,
      "text": "Am văzut un foc aprins, care alerga fără odihnă, și nu s-a oprit nici de la drum nici zi, nici noapte, ci cu regularitate."
    },
    {
      "number": 3,
      "text": "Și am întrebat: „Ce este aceasta care nu se odihnește? ”"
    },
    {
      "number": 4,
      "text": "Atunci Raguel, unul dintre îngerii sfinți care era cu mine, mi-a răspuns mi-a zis: „Acest curs de foc pe care l-ai văzut este focul din vest care persecută toți luminatorii cerului.”"
    }
  ],
