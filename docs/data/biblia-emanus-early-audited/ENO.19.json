  "verses": [
    {
      "number": 1,
      "text": "Și Uriel mi-a spus: Aici vor sta îngerii care s-au legat de femei, iar spiritele lor, asumându- multe forme diferite, pângăresc omenirea îi vor conduce pe căi greșite la jertfirea demonilor ca dumnezei, (aici vor sta) până în ziua marii judecăți în care vor fi judecați până când li se va pune capăt."
    },
    {
      "number": 2,
      "text": "Și femeile îngerilor rătăciți vor deveni sirene."
    },
    {
      "number": 3,
      "text": "Numai Eu, Enoh, am văzut vedenia, marginile tuturor lucrurilor; și nimeni nu va vedea cum am văzut eu."
    }
  ],
