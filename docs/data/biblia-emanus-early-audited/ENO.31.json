  "verses": [
    {
      "number": 1,
      "text": "Și am văzut munți, printre ei erau plantații de copaci, din ele ieșeau nectar, care se sarara galbanum."
    },
    {
      "number": 2,
      "text": "dincolo de am văzut un alt munte la răsărit de marginile pământului, pe care erau aloe-copaci, și copacii erau plini de stacte, fiind ca migdalii."
    },
    {
      "number": 3,
      "text": "Și când cineva a ars-o, a mirosit mai dulce decât orice miros parfumat."
    }
  ],
