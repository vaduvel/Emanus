  "verses": [
    {
      "number": 1,
      "text": "Și a chemat Tovie pre Rafail, și i-a zis lui: Azarie frate! Ia cu tine o slugă și două cămile și mergi în Raghisul Midiei, la Gavail și-mi adu mie argintul, și pre el îl adu la nuntă, că m-a jurat Raguil să nu ies eu."
    },
    {
      "number": 2,
      "text": "Și tatăl meu numără zilele, și de voiu zăbovi mai mult, va dori foarte."
    },
    {
      "number": 3,
      "text": "Și a mers Rafail, și a mas la Gavail, și i-a dat lui scrisoarea; iar Gavail a scos pungile pecetluite, și le-a dat lui."
    },
    {
      "number": 4,
      "text": "Și au mânecat împreună, și au venit la nuntă, și bine a cuvântat pre Tovie și pre femeia lui."
    }
  ],
